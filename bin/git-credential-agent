#!/usr/bin/env bash
# Git credential helper for the agents' push remote (`agent`): answers with the
# bot account (jason-nb-wang) and GH_TOKEN from the environment (.env via bin/opc).
# Configured per clone by bin/setup-git; never stores anything.
[ "${1:-}" = get ] || exit 0
[ -n "${GH_TOKEN:-}" ] || exit 0
echo "username=jason-nb-wang"
echo "password=$GH_TOKEN"
