#!/usr/bin/env bash
# Run OpenOPC with this repo's .opc as OPC_HOME, e.g. `bin/opc ui --project perf-ci`.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OPC_HOME="$ROOT/.opc"

# Load secrets (API keys, tokens) from the repo-root .env (gitignored) so
# OpenOPC and the agents it launches see them. Tracked configs reference
# them by variable name only (e.g. llm_config.yaml `api_key_env`).
if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.env"
  set +a
fi

# OpenOPC's LLM reaches Ollama through its OpenAI-compatible API, whose client
# requires a key; Ollama ignores it. Override in .env if your endpoint needs one.
export OLLAMA_API_KEY="${OLLAMA_API_KEY:-ollama}"

# Agents commit as the bot account jason-nb-wang (GitHub links its noreply
# address), so their commits are distinguishable and the commit-msg hook can
# require a Role trailer. They push via the `agent` remote (bin/setup-git) and
# open PRs with gh, both authenticated by GH_TOKEN from .env.
BOT_NAME="jason-nb-wang"
BOT_EMAIL="49733390+jason-nb-wang@users.noreply.github.com"
export GIT_AUTHOR_NAME="$BOT_NAME" GIT_AUTHOR_EMAIL="$BOT_EMAIL"
export GIT_COMMITTER_NAME="$BOT_NAME" GIT_COMMITTER_EMAIL="$BOT_EMAIL"

# Extra executable directories OpenOPC trusts for company-mode shell commands
# (its trusted PATH otherwise excludes Homebrew, hiding pulumi/aws/node/npm).
export OPC_TRUSTED_EXEC_PATHS="/opt/homebrew/bin"

# xcode-select points at Xcode.app, whose /usr/bin shims (git, make, ...) fail
# in agent shells with "You have not agreed to the Xcode license". The Command
# Line Tools need no license.
if [ -d /Library/Developer/CommandLineTools ]; then
  export DEVELOPER_DIR="${DEVELOPER_DIR:-/Library/Developer/CommandLineTools}"
fi
cd "$ROOT/external/OpenOPC"
exec uv run opc "$@"
