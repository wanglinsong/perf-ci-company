#!/usr/bin/env bash
# Run OpenOPC with this repo's .opc as OPC_HOME, e.g. `bin/opc ui --project perf-ci`.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export OPC_HOME="$ROOT/.opc"

# Load secrets (API keys, tokens) from the repo-root .env (gitignored) so
# OpenOPC and the agents it launches see them. Tracked configs reference
# them by variable name only (e.g. llm_config.yaml `api_key_env`).
if [ -f "$ROOT/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$ROOT/.env"
  set +a
fi

# OpenOPC's LLM reaches Ollama through its OpenAI-compatible API, whose client
# requires a key; Ollama ignores it. Override in .env if your endpoint needs one.
export OLLAMA_API_KEY="${OLLAMA_API_KEY:-ollama}"

# Agents commit as "Perf CI Agent" (you remain the committer), so their commits
# are distinguishable and the commit-msg hook can require a Role trailer.
export GIT_AUTHOR_NAME="Perf CI Agent"
export GIT_AUTHOR_EMAIL="perf-ci-agent@localhost"
cd "$ROOT/external/OpenOPC"
exec uv run opc "$@"
