# Copy to .env (gitignored) and fill in only what you use. bin/opc loads it.
# Tracked configs reference these by name; never put values in .opc/config/.

# OpenOPC's own LLM, only if llm_config.yaml uses Anthropic (api_key_env: ANTHROPIC_API_KEY)
ANTHROPIC_API_KEY=

# OpenOPC's LLM via Ollama's OpenAI-compatible API (llm_config.yaml api_key_env).
# Ollama ignores the value; bin/opc defaults it to "ollama".
OLLAMA_API_KEY=

# Cloud access for the Platform Lead (AWS + Pulumi). Agents inherit these, so
# use a dedicated, tightly scoped IAM user/role with an AWS Budget alert, and
# record the approved spend envelope in company/decisions/.
# Prefer a named profile (aws configure --profile perf-ci) over raw keys.
AWS_PROFILE=
AWS_REGION=
# Only if not using a profile:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Pulumi state backend: a local file backend needs no account.
PULUMI_BACKEND_URL=
# Absolute path to a chmod-600 file outside the repo holding the passphrase.
# Set this OR PULUMI_CONFIG_PASSPHRASE, not both. Back the passphrase up.
PULUMI_CONFIG_PASSPHRASE_FILE=
# Only if using Pulumi Cloud instead of a local backend:
# PULUMI_ACCESS_TOKEN=
