external/OpenOPC_workplace/

# OpenOPC home (OPC_HOME) for perf-ci: track config, ignore runtime state
.opc/*
!.opc/config/
.opc/config/company_orgs/*
!.opc/config/company_orgs/org_perf_ci_config.yaml
.opc/config/llm_config.yaml
.opc/config/channel_config.yaml
!.opc/memory/
!.opc/skills/
# Employee experience and learned skills (review diffs like AGENT.md edits)
!.opc/company_state/
.opc/company_state/*
!.opc/company_state/perf_ci/
!.opc/evolution/
!.opc/projects/
.opc/projects/*
!.opc/projects/perf-ci/
.opc/projects/perf-ci/*
!.opc/projects/perf-ci/employee_evolution.json
!.opc/projects/perf-ci/skills/
!.opc/projects/perf-ci/company_staffing_defaults.json
!.opc/prompts/
# Generated by `bin/opc talent import external/agency-agents`
.opc/prompts/talent/
.opc-comms/
